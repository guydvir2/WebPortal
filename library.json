    "keywords": "iot, web, portal, esp8266, esp32",
    "repository": {
        "type": "git",
        "url": "https://github.com/guydvir2/WebPortal.git"
    },
    "authors": [{"name": "guyDvir", "email": "guydvir.tech@gmail.com"}],
    "license": "MIT",
    "frameworks": "*",
    "platforms": ["espressif8266", "espressif32"],
    "build": {
        "srcDir": "src"
    },
    "dependencies": {
        "bblanchon/ArduinoJson": "^7.4.3",
        "myJflash": "https://github.com/guydvir2/myJflash.git#v0.1b"
    }
}
